  \entry{PATZOLD202020}{article}{}{}
    \name{author}{2}{}{%
      {{hash=PJ}{%
         family={Pätzold},
         familyi={P\bibinitperiod},
         given={Julius},
         giveni={J\bibinitperiod},
      }}%
      {{hash=SA}{%
         family={Schöbel},
         familyi={S\bibinitperiod},
         given={Anita},
         giveni={A\bibinitperiod},
      }}%
    }
    \keyw{Robustness and sensitivity analysis, Robust optimization, Mixed
  integer programming, Cutting-plane methods}
    \strng{namehash}{PJSA1}
    \strng{fullhash}{PJSA1}
    \field{labelnamesource}{author}
    \field{labeltitlesource}{title}
    \field{sortinit}{P}
    \field{sortinithash}{P}
    \field{abstract}{%
    In this paper we deal with cutting plane approaches for robust
  optimization. Such approaches work iteratively by solving a robust problem
  with reduced uncertainty set (robustification step) and determining a
  worst-case scenario in each iteration (pessimization step) which is then
  added to the reduced uncertainty set. We propose to enhance this scheme by
  solving the robustification and/or the pessimization step not exactly, but
  only approximately, that is, until an improvement to the current solution is
  possible. The resulting iterative approach is called approximate cutting
  plane approach. We prove that convergence to an optimal solution for
  approximate cutting plane approaches is still guaranteed under similar
  assumptions as for classical cutting plane approaches, in which both
  robustification and pessimization problem are solved exactly in each
  iteration. Experimentally, we investigate robust mixed integer linear
  optimization problems for mixed-integer polyhedral uncertainty sets of
  different difficulties. Solving the robustification or pessimization problem
  only approximately increases the number of iterations. Nevertheless, our
  results show that the approximate cutting plane approach becomes more
  efficient, in particular, if the robustification or the pessimization problem
  is hard.%
    }
    \verb{doi}
    \verb https://doi.org/10.1016/j.ejor.2019.11.059
    \endverb
    \field{issn}{0377-2217}
    \field{number}{1}
    \field{pages}{20\bibrangedash 30}
    \field{title}{Approximate cutting plane approaches for exact solutions to
  robust optimization problems}
    \verb{url}
    \verb https://www.sciencedirect.com/science/article/pii/S0377221719309713
    \endverb
    \field{volume}{284}
    \field{journaltitle}{European Journal of Operational Research}
    \field{year}{2020}
  \endentry

  \entry{RICOTTA2017201}{article}{}{}
    \name{author}{2}{}{%
      {{hash=RC}{%
         family={Ricotta},
         familyi={R\bibinitperiod},
